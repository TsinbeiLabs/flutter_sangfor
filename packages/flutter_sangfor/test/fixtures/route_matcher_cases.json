   ],
   "host": "202.114.0.9",
   "port": 80,
   "expect": true
  },
  {
   "name": "custom range entry stops at its end",
   "policy": "custom",
   "customEntries": [
    "202.114.0.1~202.114.0.9"
   ],
   "host": "202.114.0.10",
   "port": 80,
   "expect": false
  },
  {
   "name": "custom domain entries never cover addresses",
   "policy": "custom",
   "customEntries": [
    "*.whu.edu.cn"
   ],
   "host": "10.1.2.3",
   "port": 443,
   "expect": false
  },
  {
   "name": "custom bare domain does not cover subdomains",
   "policy": "custom",
   "customEntries": [
    "whu.edu.cn"
   ],
   "host": "a.whu.edu.cn",
   "port": 443,
   "expect": false
